{
  "name": "smart-campus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:kiosk": "cmd /c \"start cmd /k npm run dev && timeout /t 2 /nobreak >nul && start chrome --kiosk --ignore-certificate-errors https://localhost:5173\"",
    "start:kiosk:edge": "cmd /c \"start cmd /k npm run dev && timeout /t 2 /nobreak >nul && start msedge --kiosk --ignore-certificate-errors https://localhost:5173 --edge-kiosk-type=fullscreen\"",
    "kiosk": "cmd /c start chrome --kiosk --ignore-certificate-errors https://localhost:5173",
    "kiosk:edge": "cmd /c start msedge --kiosk --ignore-certificate-errors https://localhost:5173 --edge-kiosk-type=fullscreen",
    "kiosk:app": "cmd /c start chrome --app=https://localhost:5173 --ignore-certificate-errors",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@supabase/supabase-js": "^2.110.8",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet-rotate": "^0.2.8",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-modal-sheet": "^5.6.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.0.12",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
